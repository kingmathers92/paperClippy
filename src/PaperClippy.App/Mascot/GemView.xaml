<UserControl x:Class="PaperClippy.App.Mascot.GemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="190" Height="266" Focusable="False">

    <UserControl.Resources>
        <!-- Same path as assets/mascot/gem.svg. -->
        <Geometry x:Key="GemWire">M 40,144 L 40,66 A 19,19 0 0 1 78,66 L 78,164 A 32,32 0 0 1 14,164 L 14,54 A 41,41 0 0 1 96,54 L 96,138</Geometry>

        <SolidColorBrush x:Key="WireEdge" Color="#0D6B64" />
        <SolidColorBrush x:Key="WireBody" Color="#18A99E" />
        <SolidColorBrush x:Key="WireShine" Color="#CCA6F2E6" />
        <SolidColorBrush x:Key="Ink" Color="#1F2D3D" />

        <Style x:Key="InkLine" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Ink}" />
            <Setter Property="StrokeThickness" Value="2.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="InkFill" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource Ink}" />
            <Setter Property="Stroke" Value="{StaticResource Ink}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>

    <Canvas x:Name="Root" Width="190" Height="266">

        <!-- Body: squash, tilt and bounce animations act on this group. -->
        <Canvas x:Name="Body" Canvas.Left="40" Canvas.Top="50" Width="110" Height="206">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale" CenterX="55" CenterY="200" />
                    <RotateTransform x:Name="BodyRotate" CenterX="55" CenterY="200" />
                    <TranslateTransform x:Name="BodyShift" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Almost invisible body-shaped grab area, still hit-testable. -->
            <Rectangle Canvas.Left="5" Canvas.Top="6" Width="100" Height="196" RadiusX="46" RadiusY="46" Fill="#01000000" />

            <!-- Vinyl-coated wire: shadow, dark edge, body and glossy highlight. -->
            <Path Data="{StaticResource GemWire}" Stroke="#38000000" StrokeThickness="12"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                <Path.RenderTransform>
                    <TranslateTransform X="3" Y="5" />
                </Path.RenderTransform>
            </Path>

            <Path Data="{StaticResource GemWire}" Stroke="{StaticResource WireEdge}" StrokeThickness="13"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

            <Path Data="{StaticResource GemWire}" Stroke="{StaticResource WireBody}" StrokeThickness="9.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

            <Path Data="{StaticResource GemWire}" Stroke="{StaticResource WireShine}" StrokeThickness="2.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                <Path.RenderTransform>
                    <TranslateTransform X="-2" Y="-2.4" />
                </Path.RenderTransform>
            </Path>

            <!-- Left eye. -->
            <Canvas>
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="EyeScaleL" CenterX="44" CenterY="98" />
                </Canvas.RenderTransform>

                <Ellipse Canvas.Left="33" Canvas.Top="84" Width="22" Height="28" Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="2" />

                <Canvas>
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="PupilShiftL" />
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="39" Canvas.Top="93" Width="10" Height="14" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="40.6" Canvas.Top="94.2" Width="4" Height="4.4" Fill="White" />
                </Canvas>
            </Canvas>

            <Path x:Name="LidL" Data="M 34,98 Q 44,104 54,98" Style="{StaticResource InkLine}" Opacity="0" />

            <!-- Right eye. -->
            <Canvas>
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="EyeScaleR" CenterX="74" CenterY="98" />
                </Canvas.RenderTransform>

                <Ellipse Canvas.Left="63" Canvas.Top="84" Width="22" Height="28" Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="2" />

                <Canvas>
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="PupilShiftR" />
                    </Canvas.RenderTransform>

                    <Ellipse Canvas.Left="69" Canvas.Top="93" Width="10" Height="14" Fill="{StaticResource Ink}" />
                    <Ellipse Canvas.Left="70.6" Canvas.Top="94.2" Width="4" Height="4.4" Fill="White" />
                </Canvas>
            </Canvas>

            <Path x:Name="LidR" Data="M 64,98 Q 74,104 84,98" Style="{StaticResource InkLine}" Opacity="0" />

            <!-- Cheeks. -->
            <Ellipse x:Name="CheekL" Canvas.Left="25.5" Canvas.Top="113.8" Width="11" Height="6.4" Fill="#FF8A7A" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CheekScaleL" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="CheekR" Canvas.Left="81.5" Canvas.Top="113.8" Width="11" Height="6.4" Fill="#FF8A7A" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CheekScaleR" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Mouths: exactly one is visible at a time. -->
            <Path x:Name="MouthSmile" Data="M 48,123 Q 59,133 70,123" Style="{StaticResource InkLine}" />

            <Canvas x:Name="MouthGrin" Visibility="Collapsed">
                <Path Data="M 47,121 Q 59,139 71,121 Z" Style="{StaticResource InkFill}" />
                <Path Data="M 53,129.5 Q 59,125.5 65,129.5 Q 59,134.5 53,129.5 Z" Fill="#FF8A7A" />
            </Canvas>

            <Path x:Name="MouthNeutral" Data="M 51,125 L 67,125" Style="{StaticResource InkLine}" Visibility="Collapsed" />

            <Ellipse x:Name="MouthOpen" Canvas.Left="53.5" Canvas.Top="120" Width="11" Height="14" Fill="{StaticResource Ink}" Visibility="Collapsed" />

            <Ellipse x:Name="MouthTalkSmall" Canvas.Left="53" Canvas.Top="122.4" Width="12" Height="7.2" Fill="{StaticResource Ink}" Visibility="Collapsed" />

            <Canvas x:Name="MouthTalkWide" Visibility="Collapsed">
                <Path Data="M 49,122 Q 59,142 69,122 Z" Style="{StaticResource InkFill}" />
                <Path Data="M 54,131 Q 59,127.5 64,131 Q 59,135 54,131 Z" Fill="#FF8A7A" />
            </Canvas>

            <Path x:Name="MouthWobbly" Data="M 47,126 Q 52,120 57,126 T 70,126" Style="{StaticResource InkLine}" Visibility="Collapsed" />

            <Path x:Name="MouthSmirk" Data="M 49,127 Q 60,129 71,119" Style="{StaticResource InkLine}" Visibility="Collapsed" />

            <!-- Accessories: at most one is visible at a time. -->
            <Canvas x:Name="AccGlasses" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse Canvas.Left="28.5" Canvas.Top="82.5" Width="31" Height="31" Stroke="{StaticResource Ink}" StrokeThickness="2.8" />
                <Ellipse Canvas.Left="58.5" Canvas.Top="82.5" Width="31" Height="31" Stroke="{StaticResource Ink}" StrokeThickness="2.8" />
                <Path Data="M 59.3,96 Q 59,92.5 58.7,96" Style="{StaticResource InkLine}" StrokeThickness="2.8" />
                <Path Data="M 28.8,95 L 21,91" Style="{StaticResource InkLine}" StrokeThickness="2.8" />
                <Path Data="M 89.2,95 L 97,91" Style="{StaticResource InkLine}" StrokeThickness="2.8" />
                <Path Data="M 33,86 A 13,13 0 0 1 41,83" Stroke="White" StrokeThickness="2" Opacity="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>

            <Canvas x:Name="AccPartyHat" Visibility="Collapsed" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <RotateTransform Angle="12" CenterX="57" CenterY="18" />
                </Canvas.RenderTransform>

                <Path Data="M 36,20 L 78,20 L 57,-24 Z" Fill="#FF6FA5" Stroke="#B03A6B" StrokeThickness="2" StrokeLineJoin="Round" />
                <Path Data="M 44,5 L 70,5" Stroke="#FFE27A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 50,-8 L 64,-8" Stroke="#FFE27A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="35" Canvas.Top="16.8" Width="44" Height="6.4" Fill="#FFC93C" Stroke="#B08A12" StrokeThickness="1.6" />
                <Ellipse Canvas.Left="51.5" Canvas.Top="-31.5" Width="11" Height="11" Fill="#FFC93C" Stroke="#B08A12" StrokeThickness="1.6" />
            </Canvas>

            <Canvas x:Name="AccBowTie" Visibility="Collapsed" IsHitTestVisible="False">
                <Path Data="M 59,152 L 41,142 L 41,162 Z" Fill="#E0443E" Stroke="#8E211C" StrokeThickness="1.8" StrokeLineJoin="Round" />
                <Path Data="M 59,152 L 77,142 L 77,162 Z" Fill="#E0443E" Stroke="#8E211C" StrokeThickness="1.8" StrokeLineJoin="Round" />
                <Rectangle Canvas.Left="54" Canvas.Top="146" Width="10" Height="12" RadiusX="3" RadiusY="3" Fill="#B02A25" Stroke="#8E211C" StrokeThickness="1.8" />
            </Canvas>

            <!-- Eyebrows: only visible while Gem is expressing something. -->
            <Path x:Name="BrowL" Data="M -7,0 L 7,0" Style="{StaticResource InkLine}" StrokeThickness="2.8" Opacity="0" Visibility="Collapsed">
                <Path.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="BrowRotateL" />
                        <TranslateTransform x:Name="BrowShiftL" X="44" Y="76" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>

            <Path x:Name="BrowR" Data="M -7,0 L 7,0" Style="{StaticResource InkLine}" StrokeThickness="2.8" Opacity="0" Visibility="Collapsed">
                <Path.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="BrowRotateR" />
                        <TranslateTransform x:Name="BrowShiftR" X="74" Y="76" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- Overlays: these are not squashed or tilted with the body. -->
        <TextBlock x:Name="QuestionMark" Text="?" Canvas.Left="140" Canvas.Top="20" FontFamily="Segoe UI Black, Segoe UI" FontWeight="Black"
                   FontSize="44" Foreground="#F2692F" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="QuestionRotate" />
                    <TranslateTransform x:Name="QuestionShift" />
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <Canvas x:Name="ThoughtGroup" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse Canvas.Left="131" Canvas.Top="59" Width="6" Height="6" Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
            <Ellipse Canvas.Left="141" Canvas.Top="43" Width="10" Height="10" Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
            <Ellipse Canvas.Left="136" Canvas.Top="11" Width="48" Height="30" Fill="White" Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
            <Ellipse x:Name="ThoughtDot0" Canvas.Left="147.4" Canvas.Top="23.4" Width="5.2" Height="5.2" Fill="{StaticResource Ink}" />
            <Ellipse x:Name="ThoughtDot1" Canvas.Left="157.4" Canvas.Top="23.4" Width="5.2" Height="5.2" Fill="{StaticResource Ink}" />
            <Ellipse x:Name="ThoughtDot2" Canvas.Left="167.4" Canvas.Top="23.4" Width="5.2" Height="5.2" Fill="{StaticResource Ink}" />
        </Canvas>

        <Canvas x:Name="ZzzGroup" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="Zzz0" Text="Z" FontFamily="Segoe UI" FontWeight="ExtraBold" Foreground="#5B7FD9" />
            <TextBlock x:Name="Zzz1" Text="Z" FontFamily="Segoe UI" FontWeight="ExtraBold" Foreground="#5B7FD9" />
            <TextBlock x:Name="Zzz2" Text="Z" FontFamily="Segoe UI" FontWeight="ExtraBold" Foreground="#5B7FD9" />
        </Canvas>

        <Canvas x:Name="WorkGroup" Canvas.Left="152" Canvas.Top="40" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="WorkRotate" />
            </Canvas.RenderTransform>

            <Ellipse Canvas.Left="-12" Canvas.Top="-12" Width="24" Height="24" Stroke="#6B7A8F" StrokeThickness="7" StrokeDashArray="0.67 0.67" />
            <Ellipse Canvas.Left="-8" Canvas.Top="-8" Width="16" Height="16" Stroke="#6B7A8F" StrokeThickness="3" />
        </Canvas>

        <Canvas x:Name="ConfettiLayer" Width="190" Height="266" IsHitTestVisible="False" Visibility="Collapsed" />

    </Canvas>
</UserControl>