<Window x:Class="PaperClippy.App.Mascot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gem Settings"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Face}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="12.5"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,8,10,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14,12,14,12" Width="400">

        <GroupBox Header="Appearance">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.ColumnSpan="3" Content="Show Gem on the desktop" IsChecked="{Binding ShowGem}" />

                <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Caption}" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="50" Maximum="200" TickFrequency="25" TickPlacement="BottomRight"
                        Value="{Binding SizePercent}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding SizePercent, StringFormat={}{0:0}%}" />

                <TextBlock Grid.Row="2" Text="Accessory" Style="{StaticResource Caption}" />
                <ComboBox x:Name="AccessoryBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Accessory}" />

                <TextBlock Grid.Row="3" Text="Animation" Style="{StaticResource Caption}" />
                <ComboBox x:Name="AnimationBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                          SelectedItem="{Binding Animation}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Personality">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Attitude" Style="{StaticResource Caption}" />
                <ComboBox x:Name="PersonalityBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                          SelectedItem="{Binding Personality}" ToolTip="Gentle: kind. Playful: funny with the odd dry remark. Sassy: sarcasm on." />

                <TextBlock Grid.Row="1" Text="Speaks up on its own" Style="{StaticResource Caption}" />
                <ComboBox x:Name="ChatterBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                          SelectedItem="{Binding Chatter}" />

                <TextBlock Grid.Row="2" Text="Bubbles stay for" Style="{StaticResource Caption}" />
                <Slider Grid.Row="2" Grid.Column="1" Minimum="3" Maximum="30" TickFrequency="3" TickPlacement="BottomRight"
                        IsSnapToTickEnabled="False" Value="{Binding BubbleSeconds}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="2" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding BubbleSeconds, StringFormat={}{0:0} s}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Quiet time">
            <StackPanel>
                <CheckBox Content="Quiet mode: only speak when I ask" IsChecked="{Binding QuietMode}" />
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <CheckBox Content="Quiet hours from" IsChecked="{Binding QuietHoursEnabled}" VerticalAlignment="Center" />
                    <TextBox Width="52" Margin="8,0,6,0" TextAlignment="Center" MaxLength="5" IsEnabled="{Binding QuietHoursEnabled}"
                             Text="{Binding QuietFrom, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnTimeLostFocus"
                             ToolTip="24-hour time, for example 22:00" />
                    <TextBlock Text="to" VerticalAlignment="Center" />
                    <TextBox Width="52" Margin="6,0,0,0" TextAlignment="Center" MaxLength="5" IsEnabled="{Binding QuietHoursEnabled}"
                             Text="{Binding QuietTo, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnTimeLostFocus"
                             ToolTip="24-hour time, for example 08:00" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Behaviour">
            <StackPanel>
                <CheckBox Content="Eyes follow the mouse pointer" IsChecked="{Binding FollowPointer}" />
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Fall asleep when I'm away" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="SleepBox" Margin="0" MinWidth="150" DisplayMemberPath="Label" SelectedValuePath="Minutes"
                              SelectedValue="{Binding SleepAfterMinutes}" />
                </StackPanel>
                <CheckBox Content="Don't take keyboard focus when I click Gem (experimental)" IsChecked="{Binding KeepFocus}"
                          ToolTip="Keeps the window you were typing in active while you use Gem. Turn this off if clicking Gem or its bubbles misbehaves." />
            </StackPanel>
        </GroupBox>

        <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource Retro.Button}" Click="OnCloseClicked" />
    </StackPanel>
</Window>
